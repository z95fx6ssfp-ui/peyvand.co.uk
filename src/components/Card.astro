---
// Work card (simplified 20 Nov 2026). Picture, title, one mono line: years and forms.
// No tags on the card: tags sit at the foot of each work's page and in the Index at the
// foot of the Work page, as links. The card still carries its tags as data attributes so
// the catalogue can be filtered from the Index.
// `size="large"` adds the summary (Nist page, wherever a few works are shown big).
import type { CollectionEntry } from "astro:content";
import WorkImage from "./WorkImage.astro";
import { splitTitle, years } from "../lib/threads";

interface Props {
  entry: CollectionEntry<"work">;
  size?: "card" | "large";
  headingLevel?: "h2" | "h3";
  tone?: number;
}
const { entry, size = "card", headingLevel = "h3", tone = 0 } = Astro.props;
const d = entry.data;
const Heading = headingLevel;
const href = `/work/${entry.id}/`;
const { latin, farsi } = splitTitle(d.title);
---

<article
  class={`card card--${size}`}
  data-slug={entry.id}
  data-role={d.role.join("|")}
  data-medium={d.medium.join("|")}
  data-setting={d.setting.join("|")}
  data-status={d.status}
  data-themes={d.themes.join("|")}
  data-nist={d.producedByNist ? "1" : "0"}
>
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    <WorkImage
      entry={entry}
      tone={tone}
      widths={size === "large" ? [800, 1200, 1600] : [480, 800]}
      sizes={size === "large" ? "(min-width: 900px) 50vw, 100vw" : "(min-width: 900px) 33vw, 50vw"}
      transition
    />
    {d.status !== "produced" && <span class="card__stamp mono mono-caps">{d.status}</span>}
  </a>
  <div class="card__body">
    <Heading class="card__title">
      <a href={href}>
        <span>{latin}</span>
        {farsi && <>{" "}<span lang="fa" dir="rtl">{farsi}</span></>}
      </a>
    </Heading>
    <p class="card__facts mono">{years(d)}<span aria-hidden="true"> · </span>{d.medium.join(", ")}</p>
    {size === "large" && <p class="card__summary">{d.summary}</p>}
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; color: inherit; height: 100%; }
  .card__media { position: relative; display: block; text-decoration: none; overflow: hidden; aspect-ratio: 3 / 2; border: 1px solid var(--ink); background: var(--saffron); }
  .card__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 400ms ease-out; }
  .card:hover .card__media :global(img), .card:focus-within .card__media :global(img) { transform: scale(1.04); }
  .card__stamp {
    position: absolute; top: var(--s-3); left: var(--s-3);
    padding: 2px var(--s-2); background: var(--ink); color: var(--saffron);
    font-size: 0.75rem; font-weight: 700; transform: rotate(-3deg);
  }
  .card__body { display: flex; flex-direction: column; gap: var(--s-1); padding: var(--s-3) 0 0; }
  .card__title { margin: 0; font-size: clamp(1.25rem, 2.4vw, 1.875rem); line-height: 1; }
  .card--large .card__title { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .card__title a { color: inherit; text-decoration: none; }
  .card__title a:hover, .card__title a:focus-visible { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 4px; text-decoration-color: var(--accent); }
  .card__title [lang="fa"] { font-family: var(--font-farsi); }
  .card__facts { margin: 0; font-size: 0.8125rem; }
  .card__summary { margin: var(--s-2) 0 0; font-size: var(--p-small); }
  @media (prefers-reduced-motion: reduce) { .card__stamp { transform: none; } }
  :global(html[data-motion="reduce"]) .card__stamp { transform: none; }
</style>
