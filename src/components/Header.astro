---
// Site header (rewritten 20 Nov 2026). Two floating pieces instead of a bar:
// the halftone portrait with the name (links home) top left, and a "Menu" button top right.
// Both stay put while the page moves under them. The name tucks away once the visitor has
// scrolled, leaving the portrait. Menu opens a full-screen list of the five places on the
// site, each with one line saying what is there, so nobody has to say who they are.
// Without JavaScript the header is an ordinary bar with the five links visible.
const items = [
  { href: "/work", label: "Work", text: "Everything made and performed, newest first." },
  { href: "/work-with-me", label: "Work with me", text: "Workshops, teaching, talks, facilitation and mentoring." },
  { href: "/nist", label: "Nist", text: "The company I produce projects through." },
  { href: "/about", label: "About", text: "Bio, reel, headshots and agent." },
  { href: "/contact", label: "Contact", text: "Acting enquiries go to my agent. Everything else comes to me." },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href + "/");
---

<header class="site-header">
  <a class="site-header__home" href="/">
    <img class="site-header__logo" src="/images/logo-halftone.png" width="112" height="140" alt="" />
    <span class="site-header__name">Peyvand Sadeghian</span>
  </a>

  <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>

  <nav id="site-nav" class="site-nav" aria-label="Main">
    <ul class="site-nav__list" role="list">
      {items.map((item, i) => (
        <li style={`--i: ${i}`}>
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            <span class="site-nav__label">{item.label}</span>
            <span class="site-nav__text">{item.text}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="site-nav__foot mono">
      <a href="/work/threads/">Threads: how the work connects</a>
    </p>
  </nav>
</header>

<style>
  /* Without JavaScript: an ordinary Ink bar */
  .site-header {
    background: var(--ink);
    color: var(--paper);
    padding: var(--s-3) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
  }
  .site-header__home {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: var(--tap);
    color: var(--paper);
    background: var(--ink);
    text-decoration: none;
  }
  .site-header__logo { width: 44px; height: auto; display: block; }
  .site-header__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: var(--track-tight);
    line-height: 1;
    white-space: nowrap;
  }
  .site-header__toggle { display: none; }
  .site-nav__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); }
  .site-nav__list li { max-width: none; }
  .site-nav__list a { display: inline-flex; flex-direction: column; min-height: var(--tap); justify-content: center; color: var(--paper); text-decoration: none; }
  .site-nav__label { font-family: var(--font-display); font-weight: 700; }
  .site-nav__text, .site-nav__foot { display: none; }

  /* With JavaScript: floating pieces and a full-screen menu */
  :global(html.js) .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    background: transparent;
    padding: var(--s-3) var(--gutter);
    justify-content: space-between;
    flex-wrap: nowrap;
    pointer-events: none; /* only the two pieces take clicks */
  }
  :global(html.js) .site-header__home,
  :global(html.js) .site-header__toggle { pointer-events: auto; position: relative; z-index: 2; }
  :global(html.js) .site-header__home {
    padding: 6px;
    border: 1px solid var(--paper);
    gap: 0;
    transition: gap var(--t-drawer);
  }
  :global(html.js) .site-header__name {
    max-width: 14em;
    padding-inline: var(--s-3) var(--s-2);
    overflow: hidden;
    transition: max-width var(--t-reflow) ease, padding var(--t-reflow) ease, opacity var(--t-fast);
  }
  /* Scrolled: the name tucks away, the portrait stays. It comes back on hover and focus. */
  :global(html.js.is-scrolled) .site-header__home:not(:hover):not(:focus-visible) .site-header__name {
    max-width: 0;
    padding-inline: 0;
    opacity: 0;
  }
  :global(html.js) .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 88px;
    padding: 0 var(--s-4);
    background: var(--saffron);
    color: var(--ink);
    border: 2px solid var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: var(--track-h4);
    cursor: pointer;
    transition: background-color var(--t-fast), color var(--t-fast);
  }
  :global(html.js) .site-header__toggle:hover { background: var(--ink); color: var(--saffron); border-color: var(--saffron); }
  :global(html.js) .site-header__toggle:focus-visible,
  :global(html.js) .site-header__home:focus-visible { outline: 3px solid var(--firoozeh); outline-offset: 2px; box-shadow: 0 0 0 2px var(--paper); }

  :global(html.js) .site-nav {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: auto;
    background: var(--pomegranate);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    padding: 104px var(--gutter) var(--s-8);
    overflow-y: auto;
    visibility: hidden;
    /* Opens from the Menu button outwards */
    clip-path: circle(0 at calc(100% - 60px) 40px);
    transition: clip-path 450ms cubic-bezier(0.3, 0.7, 0.2, 1), visibility 0s 450ms;
  }
  :global(html.js) .site-nav.is-open {
    visibility: visible;
    clip-path: circle(150% at calc(100% - 60px) 40px);
    transition: clip-path 550ms cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  :global(html.js) .site-nav__list {
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 0;
    width: 100%;
    max-width: var(--max-width);
    margin: auto auto 0; /* centred when there is room, never cut off at the top when there is not */
  }
  :global(html.js) .site-nav__list li { border-top: 1px solid rgba(241, 236, 226, 0.35); }
  :global(html.js) .site-nav__list li:last-child { border-bottom: 1px solid rgba(241, 236, 226, 0.35); }
  :global(html.js) .site-nav__list a {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-1);
    padding: var(--s-3) 0;
    opacity: 0;
    transform: translateY(0.4em);
    transition: opacity 300ms ease, transform 300ms ease, color var(--t-fast);
  }
  @media (min-width: 900px) {
    :global(html.js) .site-nav__list a { grid-template-columns: 3fr 2fr; align-items: baseline; gap: var(--s-8); padding: var(--s-4) 0; }
  }
  :global(html.js) .site-nav.is-open .site-nav__list a {
    opacity: 1;
    transform: none;
    transition-delay: calc(120ms + var(--i) * 60ms), calc(120ms + var(--i) * 60ms), 0s;
  }
  :global(html.js) .site-nav__label {
    font-weight: 800;
    font-size: clamp(2.25rem, min(8vw, 11vh), 5.5rem);
    line-height: 0.95;
    letter-spacing: var(--track-tight);
  }
  :global(html.js) .site-nav__text { display: block; font-size: var(--p); max-width: 32ch; }
  :global(html.js) .site-nav__list a:hover .site-nav__label,
  :global(html.js) .site-nav__list a:focus-visible .site-nav__label,
  :global(html.js) .site-nav__list a[aria-current="page"] .site-nav__label { color: var(--saffron); }
  :global(html.js) .site-nav__list a:focus-visible { outline: 3px solid var(--saffron); outline-offset: 2px; }
  :global(html.js) .site-nav__foot {
    display: block;
    width: 100%;
    max-width: var(--max-width);
    margin: var(--s-6) auto auto;
  }
  :global(html.js) .site-nav__foot a { color: var(--paper); display: inline-block; padding-block: var(--s-2); }

  @media (min-width: 600px) {
    .site-header__logo { width: 52px; }
    .site-header__name { font-size: 1.375rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .site-nav, :global(html.js) .site-nav.is-open { clip-path: none; }
    :global(html.js) .site-nav__list a { opacity: 1; transform: none; }
  }
  :global(html.js[data-motion="reduce"]) .site-nav { clip-path: none; }
  :global(html.js[data-motion="reduce"]) .site-nav__list a { opacity: 1; transform: none; }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(".site-header__toggle");
  const nav = document.getElementById("site-nav");

  // The name tucks away after the first screenful of scrolling
  const onScroll = () => root.classList.toggle("is-scrolled", window.scrollY > 120);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  if (toggle && nav) {
    // Everything outside the header is made inert while the menu is open, so focus stays in it
    const outside = () => Array.from(document.body.children).filter((el) => !el.classList.contains("site-header") && el.tagName !== "SCRIPT");
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.textContent = open ? "Close" : "Menu";
      nav.classList.toggle("is-open", open);
      root.classList.toggle("menu-open", open);
      outside().forEach((el) => (open ? el.setAttribute("inert", "") : el.removeAttribute("inert")));
    };
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    // Coming back with the browser's Back button must not leave the menu open
    window.addEventListener("pageshow", () => setOpen(false));
  }
</script>
