---
// Video embed (design.md section 5): Vimeo or YouTube page URL in, 16:9 iframe out.
// Captions requested, autoplay off, visible title above, plain link below.
interface Props {
  url: string;
  title: string;
  heading?: string;
}
const { url, title, heading } = Astro.props;

function embedFor(u: string): { src: string; host: string } | null {
  const vimeo = u.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vimeo) return { src: `https://player.vimeo.com/video/${vimeo[1]}?dnt=1&texttrack=en&title=0&byline=0&portrait=0`, host: "Vimeo" };
  const yt = u.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{6,})/);
  if (yt) return { src: `https://www.youtube-nocookie.com/embed/${yt[1]}?cc_load_policy=1&rel=0`, host: "YouTube" };
  return null;
}
const embed = embedFor(url);
---

{embed && (
  <div class="video">
    {heading && <h2>{heading}</h2>}
    <div class="frame">
      <iframe
        src={embed.src}
        title={title}
        loading="lazy"
        allow="fullscreen; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    <p class="mono"><a href={url} rel="noopener">Watch on {embed.host}</a></p>
  </div>
)}

<style>
  .frame { aspect-ratio: 16 / 9; width: 100%; background: #000; }
  .frame iframe { width: 100%; height: 100%; display: block; }
  .video h2 { margin-top: 0; }
  .video p { margin: var(--s-3) 0 0; }
</style>
