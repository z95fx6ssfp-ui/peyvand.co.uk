---
// Homepage (rebuilt 20 Nov 2026). The page is one thread: it starts under the opening line,
// runs through the selected work, and ends at the way into everything else. Nobody is asked
// who they are; the places on the site are named for what is in them.
// Sections: opening line (saffron) · selected work along the thread (light) · where to see
// me next (pomegranate) · the other places (dark) · worked with (quiet) · stay in touch (saffron).
// Copy marked PLACEHOLDER is to be replaced by Peyvand.
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ThreadRun from "../components/ThreadRun.astro";

const entries = (await getCollection("work")).sort((a, b) => b.data.year - a.data.year);
const featured = entries.filter((e) => e.data.featured).slice(0, 6);
const places = [
  { href: "/work-with-me", label: "Work with me", text: "Workshops, teaching, talks, facilitation and mentoring." },
  { href: "/nist", label: "Nist", text: "The company I produce projects through." },
  { href: "/about", label: "About", text: "Bio, reel, headshots and agent." },
];
---

<Base title="Peyvand Sadeghian" description="Performer, performance maker and writer. Stage, screen, installation, puppetry and film.">
  <main id="main">
    <section class="opening hero" data-theme="saffron">
      <div class="wrap opening__inner">
        <h1 class="display accent settle">Performer, performance maker and writer.</h1>
        <p class="opening__lead">Stage, screen, installation, puppetry and film.</p>
        <p class="opening__cue mono"><span class="ring" id="thread-start" aria-hidden="true"></span>Follow the thread</p>
      </div>
    </section>

    {featured.length > 0 && (
      <section data-theme="light" class="thread-section">
        <div class="wrap">
          <h2 class="sr-only">Selected work</h2>
          <ThreadRun entries={featured} id="home" start="#thread-start" end="#thread-end" headingLevel="h3" />
          <p class="thread-end">
            <span class="ring" id="thread-end" aria-hidden="true"></span>
            <a class="thread-end__link" href="/work/">All the work</a>
            <a class="mono" href="/work/threads/">See how it connects</a>
          </p>
        </div>
      </section>
    )}

    <section data-theme="pomegranate" class="section">
      <div class="wrap">
        <h2 class="slab-title">Where to see me next</h2>
        <p class="lead">PLACEHOLDER: the next public date, venue and a booking link. When there is nothing booked: "Nothing announced yet. Join the list below to hear first."</p>
      </div>
    </section>

    <section data-theme="dark" class="section">
      <div class="wrap">
        <h2 class="sr-only">Also here</h2>
        <ul class="places" role="list">
          {places.map((p) => (
            <li>
              <a href={p.href}>
                <span class="places__label">{p.label}</span>
                <span class="places__text">{p.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section data-theme="quiet" class="section">
      <div class="wrap">
        <h2 class="slab-title">Worked with</h2>
        <p class="mono">PLACEHOLDER: the companies, venues and broadcasters from the 30-logo wall as a text list (or logos with alt text), e.g. Barbican · HOME · Camden People's Theatre · Netflix · BBC.</p>
      </div>
    </section>

    <section data-theme="saffron" class="section">
      <div class="wrap">
        <h2 class="slab-title">Stay in touch</h2>
        <p class="lead">Performances, projects, the occasional postcard. No filler.</p>
        <p class="mono">PLACEHOLDER: newsletter form once the provider is chosen. Until then: <a href="https://www.instagram.com/peyvandofpersia/">Instagram</a>.</p>
      </div>
    </section>
  </main>
</Base>

<style>
  .opening { min-height: 78svh; display: flex; align-items: flex-end; padding: 132px 0 var(--s-8); }
  @media (min-width: 900px) { .opening { min-height: 86svh; } }
  .opening__inner { width: 100%; }
  .opening .display { font-size: clamp(3rem, 9.5vw, 8.5rem); max-width: 12ch; margin-bottom: var(--s-6); }
  .opening__lead { font-size: clamp(1.25rem, 2.4vw, 1.875rem); font-weight: 600; margin: 0 0 var(--s-12); max-width: none; }
  .opening__cue { display: flex; align-items: center; gap: var(--s-3); margin: 0; font-weight: 700; color: var(--pomegranate); }
  .ring { display: inline-block; flex: none; width: 18px; height: 18px; border-radius: 50%; border: 3.5px solid var(--pomegranate); background: var(--pomegranate); }

  .thread-section { padding: clamp(72px, 14vh, 168px) 0 var(--s-16); }
  .thread-end { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3) var(--s-6); margin: clamp(72px, 14vh, 168px) 0 0; max-width: none; }
  .thread-end__link {
    font-family: var(--font-display); font-weight: 800; letter-spacing: var(--track-tight);
    font-size: clamp(2rem, 6vw, 4.5rem); line-height: 1; color: var(--ink);
    text-decoration-thickness: 4px; text-underline-offset: 8px; text-decoration-color: var(--pomegranate);
  }
  .thread-end__link:hover, .thread-end__link:focus-visible { color: var(--pomegranate); text-decoration-thickness: 6px; }

  .slab-title { margin: 0 0 var(--s-4); font-size: clamp(2rem, 5vw, 3.75rem); line-height: 0.95; }
  .lead { font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 600; }

  .places { list-style: none; margin: 0; padding: 0; }
  .places li { max-width: none; border-top: 1px solid rgba(241, 236, 226, 0.35); }
  .places li:last-child { border-bottom: 1px solid rgba(241, 236, 226, 0.35); }
  .places a { display: grid; gap: var(--s-1); padding: var(--s-4) 0; color: var(--paper); text-decoration: none; }
  @media (min-width: 900px) { .places a { grid-template-columns: 3fr 2fr; align-items: baseline; gap: var(--s-8); } }
  .places__label { font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, 6vw, 4.5rem); line-height: 0.95; letter-spacing: var(--track-tight); transition: color var(--t-fast); }
  .places a:hover .places__label, .places a:focus-visible .places__label { color: var(--saffron); }
  .places__text { font-size: var(--p); }
</style>
