---
import Base from "../layouts/Base.astro";
---

<Base title="Peyvand Sadeghian" description="Performer, performance maker and writer.">
  <header data-theme="dark" class="section">
    <div class="wrap">
      <p class="mono mono-caps">Site in progress · November 2026</p>
      <h1>Peyvand Sadeghian</h1>
      <p class="lead">Performer, performance maker and writer.</p>
      <p>Stage, screen, installation, puppetry and film.</p>
      <p><a href="https://www.peyvand.co.uk">The current site is at peyvand.co.uk</a></p>
    </div>
  </header>

  <main id="main">
    <section data-theme="light" class="section">
      <div class="wrap">
        <h2>Type and colour check</h2>
        <p>This page exists so the build pipeline and the design tokens can be checked in a real browser. It is not public copy.</p>
        <p class="mono">Installation · 2026 · Leicester · Lead artist · <span style="color: var(--pomegranate)">Produced by Nist</span></p>
        <p><a href="#main">A link in body text</a>, underlined, Firoozeh on Paper.</p>
        <p>
          <a class="button" href="#main">Primary button</a>
          <a class="button button--secondary" href="#main">Secondary button</a>
        </p>
        <p lang="fa">پیوند</p>
      </div>
    </section>

    <section data-theme="quiet" class="section">
      <div class="wrap">
        <p class="lead"><em>A quiet block, Rose background, for quotes, access notes and asides.</em></p>
        <p class="mono">Attribution in mono below</p>
      </div>
    </section>
  </main>

  <footer data-theme="dark" class="section rule-top">
    <div class="wrap">
      <p class="mono">Last updated: November 2026</p>
    </div>
  </footer>
</Base>
