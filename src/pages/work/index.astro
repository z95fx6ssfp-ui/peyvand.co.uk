---
// Work index: first pass. One list of every entry, newest first.
// The curated row, Card component and filter UI come in the next stage.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import FactsLine from "../../components/FactsLine.astro";
import { Image } from "astro:assets";

const entries = (await getCollection("work")).sort((a, b) => b.data.year - a.data.year);
---

<Base title="Work · Peyvand Sadeghian" description="Performance, installation, puppetry, film and writing by Peyvand Sadeghian.">
  <main id="main">
    <section data-theme="light" class="section">
      <div class="wrap">
        <h1>Work</h1>
        <p class="lead">Stage, screen, installation, puppetry, film and writing, newest first.</p>
        <ul class="work-list">
          {entries.map((entry) => (
            <li>
              {entry.data.image && (
                <a href={`/work/${entry.id}/`} tabindex="-1" aria-hidden="true">
                  <Image src={entry.data.image} alt="" widths={[480, 800]} sizes="(min-width: 600px) 480px, 100vw" class="thumb" />
                </a>
              )}
              <h2><a href={`/work/${entry.id}/`}>{entry.data.title}</a></h2>
              <FactsLine data={entry.data} />
              <p>{entry.data.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Base>

<style>
  .work-list { list-style: none; padding: 0; margin: var(--s-8) 0 0; max-width: var(--measure); }
  .work-list li + li { margin-top: var(--s-8); padding-top: var(--s-8); border-top: 1px solid var(--rule); }
  .work-list h2 { margin: 0 0 var(--s-2); }
  .thumb { display: block; width: 100%; max-width: 480px; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border: 1px solid var(--ink); margin-bottom: var(--s-4); }
</style>
