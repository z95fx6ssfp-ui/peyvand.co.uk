---
// Work index (rebuilt 20 Nov 2026). One catalogue, newest first, and one way of narrowing it:
// the Index at the foot of the page, where every tag is a link. Choosing a tag filters the
// catalogue in place, shows what is chosen above it, and puts the choice in the URL so a
// filtered view can be sent as a link. No lenses: nobody is asked who they are.
// Two notes appear only when what is being looked at calls for them: acting tags bring up the
// way to the reel and agent; the touring status brings up the booking route.
// Without JavaScript the whole catalogue shows and every link still works as a URL.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import IndexBlock from "../../components/IndexBlock.astro";
import { ROLES } from "../../content.config";

const entries = (await getCollection("work")).sort((a, b) => b.data.year - a.data.year);
const threads = (await getCollection("threads")).sort((a, b) => a.data.order - b.data.order);
const performer = JSON.stringify(ROLES.Performer);
---

<Base title="Work · Peyvand Sadeghian" description="Performance, installation, puppetry, film and writing by Peyvand Sadeghian. Browse by role, medium, theme, setting or thread.">
  <main id="main" class="work-page">
    <section data-theme="saffron" class="section head">
      <div class="wrap">
        <h1 class="display accent settle">Work</h1>
        <p class="lead">Everything made and performed, newest first.</p>
        <p class="mono jumps"><a href="#index">Browse by tag</a><a href="/work/threads/">Follow a thread</a></p>
      </div>
    </section>

    <section data-theme="light" class="section catalogue" id="catalogue">
      <div class="wrap">
        <div class="status">
          <p class="mono" id="count" aria-live="polite">{entries.length} works</p>
          <p class="chosen mono" id="chosen" hidden></p>
        </div>

        <p class="note" data-note="acting" hidden>Reel, headshots and agent details are on the <a href="/about#acting">About page</a>.</p>
        <p class="note" data-note="touring" hidden>To book a touring piece, write to <a href="mailto:assistant@peyvand.co.uk">assistant@peyvand.co.uk</a>.</p>

        <div class="grid" id="grid">
          {entries.map((e, i) => <Card entry={e} tone={i} headingLevel="h2" />)}
        </div>
        <p class="lead" id="empty" hidden>Nothing has all of those tags at once. Take one off.</p>
      </div>
    </section>

    <section data-theme="dark" class="section" id="index">
      <div class="wrap">
        <IndexBlock entries={entries} threads={threads} />
      </div>
    </section>
  </main>
</Base>

<script is:inline id="performer-roles" type="application/json" set:html={performer}></script>

<style>
  .head .lead { font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 600; margin-bottom: var(--s-6); }
  .jumps { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); margin: 0; max-width: none; }
  .jumps a { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; }

  .status { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-6); margin-bottom: var(--s-6); min-height: var(--tap); }
  .status p { margin: 0; max-width: none; }
  .chosen { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .chosen :global(button) {
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: 36px; padding: 2px var(--s-3);
    background: var(--saffron); color: var(--ink); border: 1px solid var(--ink); border-radius: 0;
    font: inherit; font-weight: 700; cursor: pointer;
  }
  .chosen :global(button:hover) { background: var(--ink); color: var(--saffron); }
  .chosen :global(a) { margin-left: var(--s-2); }
  .note { margin: 0 0 var(--s-6); padding: var(--s-3) var(--s-4); background: var(--rose); border-left: 4px solid var(--pomegranate); max-width: none; }

  /* Two columns on phones, three on desktop */
  .grid { display: grid; gap: var(--s-8) var(--s-3); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 600px) { .grid { gap: var(--s-12) var(--grid-gap); } }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .grid > :global(.card) { transition: opacity var(--t-reflow), transform var(--t-reflow); }
  @supports (transition-behavior: allow-discrete) {
    .grid > :global(.card) { transition: opacity var(--t-reflow), transform var(--t-reflow), display var(--t-reflow) allow-discrete; }
    .grid > :global(.card[hidden]) { display: none; opacity: 0; transform: translateY(12px); }
    @starting-style { .grid > :global(.card) { opacity: 0; transform: translateY(12px); } }
  }
  #empty { margin-top: var(--s-6); }
</style>

<script>
  // The chosen tags live in the URL. Groups combine with AND, words within a group with OR.
  const GROUPS = ["role", "medium", "themes", "setting", "status"] as const;
  const PERFORMER: string[] = JSON.parse(document.getElementById("performer-roles")!.textContent || "[]");
  const grid = document.getElementById("grid")!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>(".card"));
  const countEl = document.getElementById("count")!;
  const chosenEl = document.getElementById("chosen")!;
  const empty = document.getElementById("empty")!;
  const catalogue = document.getElementById("catalogue")!;

  const has = (card: HTMLElement, group: string, value: string) => (card.dataset[group] || "").split("|").includes(value);

  function read() {
    const p = new URLSearchParams(location.search);
    const sel: Record<string, string[]> = {};
    for (const g of GROUPS) sel[g] = p.getAll(g).filter(Boolean);
    return { sel, nist: p.get("nist") === "1" };
  }

  function write(state: ReturnType<typeof read>) {
    const p = new URLSearchParams();
    for (const g of GROUPS) for (const v of state.sel[g]) p.append(g, v);
    if (state.nist) p.set("nist", "1");
    const q = p.toString();
    history.pushState(null, "", q ? `/work/?${q}` : "/work/");
  }

  function apply() {
    const { sel, nist } = read();
    const any = GROUPS.some((g) => sel[g].length) || nist;

    let shown = 0;
    for (const c of cards) {
      let ok = true;
      if (nist && c.dataset.nist !== "1") ok = false;
      for (const g of GROUPS) if (sel[g].length && !sel[g].some((v) => has(c, g, v))) ok = false;
      c.hidden = !ok;
      if (ok) shown++;
    }
    countEl.textContent = any ? `${shown} of ${cards.length} works` : `${cards.length} works`;
    empty.hidden = shown > 0;

    // What is chosen, each word a button that takes it off again
    chosenEl.textContent = "";
    if (any) {
      const add = (group: string, value: string, label: string) => {
        const b = document.createElement("button");
        b.type = "button";
        b.dataset.group = group;
        b.dataset.value = value;
        b.textContent = `${label} ×`;
        b.setAttribute("aria-label", `Remove ${label}`);
        chosenEl.append(b);
      };
      for (const g of GROUPS) for (const v of sel[g]) add(g, v, v);
      if (nist) add("nist", "1", "Produced by Nist");
      const clear = document.createElement("a");
      clear.href = "/work/";
      clear.id = "clear";
      clear.textContent = "Show everything";
      chosenEl.append(clear);
    }
    chosenEl.hidden = !any;

    // Mark the chosen words in the Index
    document.querySelectorAll<HTMLElement>("[data-index-link]").forEach((a) => {
      const g = a.dataset.indexLink!, v = a.dataset.value!;
      const on = g === "nist" ? nist : (sel[g] || []).includes(v);
      if (on) a.setAttribute("aria-current", "true"); else a.removeAttribute("aria-current");
    });

    // Notes that follow what is being looked at
    const acting = sel.role.some((r) => PERFORMER.includes(r)) || sel.medium.some((m) => m === "film" || m === "television");
    document.querySelector<HTMLElement>('[data-note="acting"]')!.hidden = !acting;
    document.querySelector<HTMLElement>('[data-note="touring"]')!.hidden = !sel.status.includes("touring");
  }

  function toggle(group: string, value: string) {
    const state = read();
    if (group === "nist") state.nist = !state.nist;
    else {
      const list = state.sel[group];
      if (!list) return;
      const i = list.indexOf(value);
      if (i >= 0) list.splice(i, 1); else list.push(value);
    }
    write(state);
    apply();
  }

  document.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("a, button");
    if (!el) return;
    if (el.id === "clear") {
      e.preventDefault();
      history.pushState(null, "", "/work/");
      apply();
      return;
    }
    const group = el.dataset.indexLink || (el.closest("#chosen") ? el.dataset.group : undefined);
    if (group && group !== "thread" && el.dataset.value !== undefined) {
      e.preventDefault();
      toggle(group, el.dataset.value);
      if (el.dataset.indexLink) {
        catalogue.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches || document.documentElement.dataset.motion === "reduce" ? "auto" : "smooth" });
      }
    }
  });
  window.addEventListener("popstate", apply);
  apply();
</script>
