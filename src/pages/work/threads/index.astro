---
// Threads (rebuilt 20 Nov 2026): the map of how the work connects. Every work is pinned to a
// board, oldest to newest, and each thread is a line drawn through the works it runs across,
// in its own colour and dash. A thread with one work so far trails off as a loose end.
// The board is a picture of the structure; the same structure follows as "Thread by thread",
// which is what phones, keyboards and screen readers use (the board is hidden from them).
// Nothing here is laid out by hand: positions and lines come from the entries at build time.
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import WorkImage from "../../../components/WorkImage.astro";
import { splitTitle, threadStyle, years } from "../../../lib/threads";

const threads = (await getCollection("threads")).sort((a, b) => a.data.order - b.data.order);
const work = (await getCollection("work")).sort((a, b) => a.data.year - b.data.year || a.id.localeCompare(b.id));

// Board geometry. Works snake across in rows of up to four, so time always reads along the line.
const W = 1200;
const ROW = 340;
const cols = Math.max(1, Math.min(4, work.length));
const rows = Math.max(1, Math.ceil(work.length / cols));
const H = rows * ROW + 150;
const pos = new Map<string, { x: number; y: number }>();
work.forEach((e, i) => {
  const row = Math.floor(i / cols);
  let col = i % cols;
  if (row % 2) col = cols - 1 - col;
  pos.set(e.id, { x: (W * (col + 0.5)) / cols, y: 150 + row * ROW + (col % 2 ? 70 : -30) });
});

const f = (n: number) => n.toFixed(1);
const lines = threads.map((t, k) => {
  const style = threadStyle(k);
  const lift = (k - (threads.length - 1) / 2) * 12; // parallel threads do not sit on top of each other
  const pts = work.filter((e) => e.data.thread.some((x) => x.id === t.id)).map((e) => ({ x: pos.get(e.id)!.x, y: pos.get(e.id)!.y + lift }));
  let d = "";
  let end: { x: number; y: number } | null = null;
  if (pts.length === 1) {
    // A loose end: one work so far
    const a = pts[0];
    end = { x: Math.min(W - 30, a.x + 150 + k * 16), y: Math.min(H - 24, a.y + 150 + k * 10) };
    d = `M ${f(a.x)} ${f(a.y)} C ${f(a.x + 20)} ${f(a.y + 90)}, ${f(end.x - 90)} ${f(end.y - 10)}, ${f(end.x)} ${f(end.y)}`;
  } else if (pts.length > 1) {
    d = `M ${f(pts[0].x)} ${f(pts[0].y)}`;
    for (let i = 1; i < pts.length; i++) {
      const a = pts[i - 1], b = pts[i];
      const dx = b.x - a.x, dy = b.y - a.y;
      d += Math.abs(dx) < 60
        ? ` C ${f(a.x + 80)} ${f(a.y + dy * 0.4)}, ${f(b.x + 80)} ${f(a.y + dy * 0.6)}, ${f(b.x)} ${f(b.y)}`
        : ` C ${f(a.x + dx * 0.5)} ${f(a.y)}, ${f(b.x - dx * 0.5)} ${f(b.y)}, ${f(b.x)} ${f(b.y)}`;
    }
  }
  return { id: t.id, title: t.data.title, placeholder: t.data.placeholder, style, d, end, n: pts.length };
});
const worksOn = (id: string) => work.filter((e) => e.data.thread.some((x) => x.id === id));
const border = (dash: string) => (dash === "" ? "solid" : dash.startsWith("2 ") ? "dotted" : "dashed");
---

<Base title="Threads · Work · Peyvand Sadeghian" description="How Peyvand Sadeghian's work connects: the questions that run across it, whatever form it took.">
  <main id="main">
    <section data-theme="light" class="section top">
      <div class="wrap">
        <h1 class="display accent settle">Threads</h1>
        <p class="lead">Recurring questions that run across the work, whatever form it took. Each line is a thread, drawn through the pieces it runs across.</p>

        <ul class="legend" role="list">
          {lines.map((l) => (
            <li>
              <a href={`/work/threads/${l.id}/`} data-key={l.id}>
                <svg viewBox="0 0 56 12" width="56" height="12" aria-hidden="true" focusable="false">
                  <path d="M2 6 H54" fill="none" stroke={l.style.colour} stroke-width="3.5" stroke-linecap="round" stroke-dasharray={l.style.dash || undefined} />
                </svg>
                <span>{l.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="wrap board-wrap">
        <div class="board" aria-hidden="true" style={`aspect-ratio: ${W} / ${H}`}>
          <svg class="board__lines" viewBox={`0 0 ${W} ${H}`}>
            {lines.map((l) => l.d && (
              <g class="board__thread" data-on={l.id}>
                <path d={l.d} fill="none" stroke={l.style.colour} stroke-width="4" stroke-linecap="round" stroke-dasharray={l.style.dash || undefined} />
                {l.end && <circle cx={l.end.x} cy={l.end.y} r="7" fill="var(--paper)" stroke={l.style.colour} stroke-width="3.5" />}
              </g>
            ))}
          </svg>
          {work.map((e, i) => {
            const p = pos.get(e.id)!;
            const t = splitTitle(e.data.title);
            return (
              <a class="pin" href={`/work/${e.id}/`} tabindex="-1" data-on={e.data.thread.map((x) => x.id).join(" ")} style={`left: ${(p.x / W) * 100}%; top: ${(p.y / H) * 100}%`}>
                <span class="pin__media"><WorkImage entry={e} tone={i} widths={[240, 480]} sizes="200px" /></span>
                <span class="pin__title">{t.latin}</span>
                <span class="pin__year mono">{years(e.data)}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section data-theme="quiet" class="section">
      <div class="wrap">
        <h2 class="by-title">Thread by thread</h2>
        {lines.map((l) => (
          <section class="strand" style={`--thread: ${l.style.colour}; --line: ${border(l.style.dash)}`}>
            <h3 class="strand__title"><a href={`/work/threads/${l.id}/`}>{l.title}</a></h3>
            <p class="mono strand__meta">{l.n} {l.n === 1 ? "work" : "works"}{l.placeholder && " · working title"}</p>
            <ol class="strand__works" role="list">
              {worksOn(l.id).map((e, i) => {
                const t = splitTitle(e.data.title);
                return (
                  <li>
                    <a href={`/work/${e.id}/`}>
                      <span class="strand__knot" aria-hidden="true"></span>
                      <span class="strand__media"><WorkImage entry={e} tone={i} widths={[240, 480]} sizes="(min-width: 900px) 220px, 45vw" /></span>
                      <span class="strand__name">
                        <span>{t.latin}</span>
                        {t.farsi && <>{" "}<span lang="fa" dir="rtl">{t.farsi}</span></>}
                      </span>
                      <span class="mono strand__year">{years(e.data)}</span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
        <p class="mono back"><a href="/work/">All the work</a></p>
      </div>
    </section>
  </main>
</Base>

<style>
  .top { padding-bottom: var(--s-12); overflow: hidden; }
  .lead { font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 600; max-width: 52ch; }
  .legend { list-style: none; margin: var(--s-6) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-8); }
  .legend li { max-width: none; }
  .legend a { display: inline-flex; align-items: center; gap: var(--s-3); min-height: var(--tap); color: var(--ink); font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; }

  /* The board: desktop and tablet only. Phones get "Thread by thread" below. */
  .board-wrap { display: none; }
  @media (min-width: 760px) { .board-wrap { display: block; margin-top: var(--s-8); } }
  .board { position: relative; width: 100%; }
  .board__lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; animation: string 1400ms cubic-bezier(0.3, 0.6, 0.2, 1) both; }
  @keyframes string { from { clip-path: inset(-5% 100% -5% 0); } to { clip-path: inset(-5% -5% -5% 0); } }
  .board__thread { transition: opacity 200ms; }
  .pin {
    position: absolute; transform: translate(-50%, -50%);
    width: clamp(120px, 15%, 190px);
    display: grid; gap: 2px;
    padding: 6px 6px 8px;
    background: var(--paper); border: 1px solid var(--ink);
    color: var(--ink); text-decoration: none;
    transition: opacity 200ms, transform 200ms ease-out, box-shadow 200ms;
  }
  .pin:nth-child(odd) { rotate: -1.5deg; }
  .pin:nth-child(even) { rotate: 1.2deg; }
  .pin:hover { transform: translate(-50%, -50%) scale(1.06); box-shadow: 6px 6px 0 var(--ink); z-index: 2; }
  .pin__media { display: block; aspect-ratio: 3 / 2; overflow: hidden; }
  .pin__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pin__title { font-family: var(--font-display); font-weight: 800; font-size: 1rem; line-height: 1.05; letter-spacing: var(--track-h4); margin-top: 4px; }
  .pin__year { font-size: 0.75rem; }
  .board :global(.is-dim) { opacity: 0.16; }

  .by-title { margin: 0 0 var(--s-8); font-size: clamp(2rem, 5vw, 3.75rem); line-height: 0.95; }
  .strand { margin-bottom: var(--s-16); }
  .strand__title { margin: 0; font-size: clamp(1.5rem, 3.4vw, 2.5rem); line-height: 1; }
  .strand__title a { color: var(--ink); text-decoration-color: var(--thread); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .strand__meta { margin: var(--s-2) 0 var(--s-6); }
  .strand__works { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; border-top: 3.5px var(--line) var(--thread); }
  @media (min-width: 760px) { .strand__works { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); } }
  .strand__works li { max-width: none; }
  .strand__works a { position: relative; display: grid; gap: 2px; padding: var(--s-8) var(--s-4) 0 0; color: var(--ink); text-decoration: none; }
  .strand__knot { position: absolute; left: 0; top: -11px; width: 18px; height: 18px; border-radius: 50%; background: var(--thread); border: 3px solid var(--rose); box-shadow: 0 0 0 1px var(--thread); }
  .strand__media { display: block; aspect-ratio: 3 / 2; overflow: hidden; border: 1px solid var(--ink); }
  .strand__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .strand__name { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; line-height: 1.05; letter-spacing: var(--track-h4); margin-top: var(--s-2); }
  .strand__name [lang="fa"] { font-family: var(--font-farsi); }
  .strand__works a:hover .strand__name, .strand__works a:focus-visible .strand__name { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 4px; text-decoration-color: var(--thread); }
  .strand__year { font-size: 0.8125rem; }
  .back a { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; }

  @media (prefers-reduced-motion: reduce) { .board__lines { animation: none; } .pin, .pin:nth-child(odd), .pin:nth-child(even) { rotate: none; } }
  :global(html[data-motion="reduce"]) .board__lines { animation: none; }
</style>

<script>
  // Pointing at a thread's name or line, or at a pinned work, picks out what it connects to.
  const board = document.querySelector<HTMLElement>(".board");
  if (board) {
    const parts = Array.from(board.querySelectorAll<HTMLElement | SVGElement>("[data-on]"));
    const show = (keys: string[] | null) =>
      parts.forEach((el) => {
        const on = ((el as HTMLElement).dataset.on || "").split(" ");
        el.classList.toggle("is-dim", !!keys && !keys.some((k) => on.includes(k)));
      });
    document.querySelectorAll<HTMLElement>(".legend a").forEach((a) => {
      const key = a.dataset.key!;
      a.addEventListener("pointerenter", () => show([key]));
      a.addEventListener("focus", () => show([key]));
      a.addEventListener("pointerleave", () => show(null));
      a.addEventListener("blur", () => show(null));
    });
    parts.forEach((el) => {
      el.addEventListener("pointerenter", () => show(((el as HTMLElement).dataset.on || "").split(" ").filter(Boolean)));
      el.addEventListener("pointerleave", () => show(null));
    });
  }
</script>
