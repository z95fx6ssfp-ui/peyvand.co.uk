---
// One page per Work entry. Bold template, 6 Nov 2026 (design.md sections 4 and 5):
// hero photograph with the title over it, trailer, quote wall, strapline and prose on
// Saffron, press quotes on Ink, gallery on Saffron, links on Paper.
// 20 Nov 2026: tags moved from the hero to the foot of the page as plain links ("Filed under"),
// and the page now ends by handing the visitor on: each thread this work is on leads to the
// next work along it, then connected work. Sections that have no content are left out.
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import FactsLine from "../../components/FactsLine.astro";
import VideoEmbed from "../../components/VideoEmbed.astro";
import { Image } from "astro:assets";
import WorkImage from "../../components/WorkImage.astro";
import { splitTitle, tagHref, threadStyle, years } from "../../lib/threads";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const all = await getCollection("work");
const connected = d.connected.map((id) => all.find((e) => e.id === id)).filter(Boolean);

// Split a title such as "DUAL دوگانه" into its Latin and Farsi parts so the Farsi
// gets lang="fa" and the right face (design.md section 8).
const farsi = d.title.match(/[؀-ۿ][؀-ۿ\s‌]*/);
const latin = farsi ? d.title.replace(farsi[0], "").trim() : d.title;
// The placeholder file counts as no photograph: the page opens on a saffron block instead.
const realImage = d.image && !/placeholder/.test(d.image.src);
const hasBody = headings.length > 0 || entry.body?.trim();
const allThreads = (await getCollection("threads")).sort((a, b) => a.data.order - b.data.order);
const threads = d.thread.map((t) => allThreads.find((x) => x.id === t.id)).filter(Boolean);

// Where the page hands the visitor on. For each thread this work is on: the next work along
// it (oldest to newest, wrapping round). Then connected work, then, if there is still nothing,
// the next work in the catalogue. A work is offered once; if two threads lead to the same
// work, both threads are named on it.
type Onward = { entry: (typeof all)[number]; via: { title: string; id?: string; colour: string; dash: string }[] };
const onward: Onward[] = [];
const offer = (entry: (typeof all)[number], via: Onward["via"][number]) => {
  if (entry.id === Astro.props.entry.id) return;
  const found = onward.find((o) => o.entry.id === entry.id);
  if (found) found.via.push(via);
  else onward.push({ entry, via: [via] });
};
for (const t of threads) {
  const along = all.filter((e) => e.data.thread.some((x) => x.id === t!.id)).sort((a, b) => a.data.year - b.data.year);
  if (along.length < 2) continue;
  const next = along[(along.findIndex((e) => e.id === entry.id) + 1) % along.length];
  const style = threadStyle(allThreads.findIndex((x) => x.id === t!.id));
  offer(next, { title: t!.data.title, id: t!.id, colour: style.colour, dash: style.dash });
}
for (const c of connected) if (!onward.some((o) => o.entry.id === c!.id)) offer(c!, { title: "Connected work", colour: "var(--ink)", dash: "" });
if (onward.length === 0 && all.length > 1) {
  const byYear = [...all].sort((a, b) => b.data.year - a.data.year);
  offer(byYear[(byYear.findIndex((e) => e.id === entry.id) + 1) % byYear.length], { title: "Next in the catalogue", colour: "var(--ink)", dash: "" });
}
---

<Base title={`${d.title} · Peyvand Sadeghian`} description={d.summary}>
  <main id="main">
    <article>
      {/* 1. Hero */}
      {realImage ? (
        <section class="hero" data-theme="dark">
          <Image class="hero-img" src={d.image!} alt={d.imageAlt ?? ""} widths={[800, 1200, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" style={`view-transition-name: work-${entry.id}`} />
          <div class="hero-text">
            <div class="wrap">
              <p class="mono crumb"><a href="/work/">Work</a></p>
              <h1 class="display settle">
                <span>{latin}</span>{" "}
                {farsi && <span lang="fa" dir="rtl">{farsi[0].trim()}</span>}
              </h1>
              <FactsLine data={d} />
              {d.photographer && <p class="mono credit">Photo: {d.photographer}</p>}
            </div>
          </div>
        </section>
      ) : (
        <section class="hero hero--plain" data-theme="saffron">
          <div class="wrap">
            <p class="mono crumb"><a href="/work/">Work</a></p>
            <h1 class="display accent settle">
              <span>{latin}</span>{" "}
              {farsi && <span lang="fa" dir="rtl">{farsi[0].trim()}</span>}
            </h1>
            <FactsLine data={d} />
          </div>
        </section>
      )}

      {/* 2. Video, straight after the hero */}
      {d.video && (
        <section data-theme="dark" class="section">
          <div class="wrap">
            <VideoEmbed url={d.video} title={`${d.videoTitle ?? "Video"}: ${d.title}`} heading={d.videoTitle ?? "Watch"} />
          </div>
        </section>
      )}

      {/* 3. Audience quote wall */}
      {d.audienceQuotes.length > 0 && (
        <section data-theme="pomegranate" class="section wall">
          <div class="wrap">
            <h2 class="mono mono-caps wall-title">From the audience</h2>
            <ul class="quotes" role="list">
              {d.audienceQuotes.map((q) => (
                <li class="rise"><q>{q}</q></li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {/* 4. Strapline, lead and prose */}
      <section data-theme="saffron" class="section">
        <div class="wrap">
          {d.strapline && <p class="display accent strap">{d.strapline}</p>}
          <p class="lead">{d.summary}</p>
          {d.funders.length > 0 && <p class="mono">Funded and supported by {d.funders.join(", ")}</p>}
          {hasBody && (
            <div class="prose">
              <Content />
            </div>
          )}
        </div>
      </section>

      {/* 5. Press quotes */}
      {d.pressQuotes.length > 0 && (
        <section data-theme="dark" class="section">
          <div class="wrap">
            <h2 class="mono mono-caps wall-title">Press</h2>
            <ul class="press" role="list">
              {d.pressQuotes.map((p) => (
                <li>
                  <blockquote>
                    <p>{p.quote}</p>
                    <footer class="mono">{p.source}</footer>
                  </blockquote>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {/* 6. Gallery */}
      {d.gallery.length > 0 && (
        <section data-theme="saffron" class="section">
          <div class="wrap">
            <h2 class="mono mono-caps wall-title">Pictures</h2>
            <ul class="gallery" role="list">
              {d.gallery.map((g) => (
                <li class={`rise${g.image.height > g.image.width ? " tall" : ""}`}>
                  <figure>
                    <Image src={g.image} alt={g.alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 400px, 50vw" />
                    {g.photographer && <figcaption class="mono">Photo: {g.photographer}</figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {/* 7. Links */}
      {d.links.length > 0 && (
        <section data-theme="light" class="section">
          <div class="wrap">
            <h2>Read more</h2>
            <ul class="links mono">
              {d.links.map((l) => (
                <li><a href={l.url} rel="noopener">{l.label}</a></li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {/* 8. Tags, at the foot, as links */}
      <section data-theme="light" class="section filed">
        <div class="wrap">
          <h2 class="filed__title">Filed under</h2>
          <ul class="filed__list mono" role="list">
            {d.role.map((r) => <li><a href={tagHref("role", r)}>{r}</a></li>)}
            {d.medium.map((m) => <li><a href={tagHref("medium", m)}>{m}</a></li>)}
            {d.setting.map((x) => <li><a href={tagHref("setting", x)}>{x}</a></li>)}
            {d.status !== "produced" && <li><a href={tagHref("status", d.status)}>{d.status}</a></li>}
            {d.producedByNist && <li><a href="/work/?nist=1">Produced by Nist</a></li>}
          </ul>
          {threads.length > 0 && (
            <p class="filed__threads mono">
              {threads.length === 1 ? "Thread: " : "Threads: "}
              {threads.map((t, i) => <>{i > 0 && ", "}<a href={`/work/threads/${t!.id}/`}>{t!.data.title}</a></>)}
            </p>
          )}
        </div>
      </section>

      {/* 9. Onward: the page ends by leading somewhere */}
      {onward.length > 0 && (
        <section data-theme="quiet" class="section onward">
          <div class="wrap">
            <h2 class="onward__title">Keep following</h2>
            <ul class={`onward__list onward__list--${Math.min(onward.length, 3)}`} role="list">
              {onward.map((o, i) => {
                const t = splitTitle(o.entry.data.title);
                return (
                  <li>
                    <a class="onward__link" href={`/work/${o.entry.id}/`}>
                      <svg class="onward__line" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <path d="M0 12 C 60 -4, 110 28, 180 12 S 320 -2, 400 12" fill="none" stroke={o.via[0].colour} stroke-width="3.5" stroke-linecap="round" stroke-dasharray={o.via[0].dash || undefined} vector-effect="non-scaling-stroke" />
                      </svg>
                      <span class="onward__via mono">
                        {o.via.map((v, k) => <>{k > 0 && " and "}{v.title}</>)}
                        {o.via[0].id ? " continues with" : ""}
                      </span>
                      <span class="onward__name">
                        <span>{t.latin}</span>
                        {t.farsi && <>{" "}<span lang="fa" dir="rtl">{t.farsi}</span></>}
                      </span>
                      <span class="onward__media"><WorkImage entry={o.entry} tone={i + 1} widths={[480, 800, 1200]} sizes="(min-width: 900px) 45vw, 100vw" /></span>
                      <span class="onward__facts mono">{years(o.entry.data)}<span aria-hidden="true"> · </span>{o.entry.data.medium.join(", ")}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
            <p class="onward__all mono"><a href="/work/">All the work</a><a href="/work/threads/">See how it connects</a></p>
          </div>
        </section>
      )}
    </article>
  </main>
</Base>

<style>
  /* Display type: the title is the biggest thing on the page (design.md section 4) */
  .display {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--display);
    line-height: 0.95;
    letter-spacing: var(--track-tight);
    margin: 0 0 var(--s-4);
    max-width: none;
    overflow-wrap: anywhere;
  }
  .display [lang="fa"] { font-family: var(--font-farsi); font-weight: 800; display: inline-block; margin-inline-start: 0.15em; line-height: 1.1; }
  .accent { color: var(--accent); }

  /* 1. Hero */
  .hero { position: relative; min-height: 75vh; display: flex; align-items: flex-end; overflow: hidden; }
  @media (min-width: 900px) { .hero { min-height: 88vh; } }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-text {
    position: relative;
    width: 100%;
    padding: var(--s-16) 0 var(--s-8);
    /* Solid Ink where the text sits, fading upwards over the photograph */
    background: linear-gradient(to top, var(--ink) 0%, var(--ink) 45%, rgba(26, 26, 26, 0.75) 72%, rgba(26, 26, 26, 0) 100%);
  }
  .hero-text .display { color: var(--saffron); }
  .hero.hero--plain { min-height: 0; padding: 148px 0 var(--s-8); }
  .crumb { margin: 0 0 var(--s-4); }
  .credit { margin: var(--s-2) 0 0; opacity: 0.85; }

  /* 3. Quote wall: a poster, not a list. DOM order is reading order; sizes are CSS only. */
  .wall-title { margin: 0 0 var(--s-8); font-weight: 700; }
  .quotes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: var(--s-3) var(--s-8); text-align: center; }
  .quotes li { max-width: 100%; font-family: var(--font-display); font-weight: 800; line-height: 1; letter-spacing: var(--track-tight); font-size: clamp(1.5rem, 4vw, 2.75rem); }
  .quotes li:nth-child(3n) { color: var(--saffron); }
  .quotes li:nth-child(4n + 2) { font-size: clamp(2rem, 6vw, 4.5rem); }
  .quotes li:nth-child(9) { font-size: clamp(2.5rem, 9vw, 7rem); flex-basis: 100%; }
  .quotes li:nth-child(5n + 1) { font-size: clamp(1.25rem, 3vw, 2rem); }
  .quotes q { quotes: "\201C" "\201D"; }
  .quotes li:nth-child(2n) { transform: rotate(-1.5deg); }
  .quotes li:nth-child(7n) { transform: rotate(1.5deg); }

  /* 4. Strapline and prose */
  .strap { margin-bottom: var(--s-8); }
  .lead { font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 600; max-width: var(--measure); margin-bottom: var(--s-8); }
  .prose { max-width: var(--measure); }
  /* On desktop the prose runs in two columns like a freesheet; headings stay with their text */
  @media (min-width: 900px) {
    .prose { max-width: none; columns: 2; column-gap: var(--s-12); }
    .prose :global(p), .prose :global(h2) { break-inside: avoid; max-width: none; }
    .prose :global(h2) { break-after: avoid; }
    .prose :global(h2:first-child) { margin-top: 0; }
  }

  /* 5. Press quotes */
  .press { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-8) var(--s-12); }
  @media (min-width: 900px) { .press { grid-template-columns: 1fr 1fr; } }
  .press blockquote { margin: 0; max-width: none; }
  .press blockquote p { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.05; letter-spacing: var(--track-tight); color: var(--saffron); margin: 0 0 var(--s-3); max-width: none; }
  .press blockquote p::before { content: "\201C"; }
  .press blockquote p::after { content: "\201D"; }

  /* 6. Gallery: two columns on phones, three on desktop, portraits take two rows */
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 42vw; grid-auto-flow: dense; gap: var(--s-3); }
  @media (min-width: 900px) { .gallery { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 260px; gap: var(--s-4); } }
  .gallery li.tall { grid-row: span 2; }
  .gallery figure { margin: 0; height: 100%; position: relative; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; border: 1px solid var(--ink); }
  .gallery figcaption { position: absolute; left: 0; bottom: 0; padding: var(--s-1) var(--s-2); background: var(--ink); color: var(--paper); font-size: 0.75rem; }

  /* 7. Links */
  .links { list-style: none; padding: 0; margin: var(--s-4) 0 0; }
  .links li + li { margin-top: var(--s-2); }

  /* 8. Tags at the foot */
  .filed { padding-block: var(--s-12); border-top: 1px solid var(--ink); }
  .filed__title { margin: 0 0 var(--s-3); font-size: var(--h3); }
  .filed__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--s-6); }
  .filed__list li { max-width: none; }
  .filed__list a, .filed__threads a { display: inline-flex; align-items: center; min-height: var(--tap); }
  .filed__threads { margin: var(--s-2) 0 0; max-width: none; }

  /* 9. Onward */
  .onward__title { margin: 0 0 var(--s-8); font-size: clamp(2.25rem, 7vw, 5.5rem); line-height: 0.95; color: var(--pomegranate); }
  .onward__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-12) var(--grid-gap); }
  .onward__list li { max-width: none; }
  @media (min-width: 900px) {
    .onward__list--2 { grid-template-columns: repeat(2, 1fr); }
    .onward__list--3 { grid-template-columns: repeat(3, 1fr); }
    .onward__list--1 .onward__link { grid-template-columns: 2fr 3fr; column-gap: var(--s-12); }
    .onward__list--1 .onward__line { grid-column: 1 / -1; }
    .onward__list--1 .onward__media { grid-column: 2; grid-row: 2 / span 4; }
  }
  .onward__link { display: grid; gap: var(--s-2); color: var(--ink); text-decoration: none; align-content: start; }
  .onward__line { width: 100%; height: 24px; overflow: visible; }
  .onward__via { font-weight: 700; }
  .onward__name { font-family: var(--font-display); font-weight: 800; font-size: clamp(2rem, 5vw, 4rem); line-height: 0.95; letter-spacing: var(--track-tight); }
  .onward__name [lang="fa"] { font-family: var(--font-farsi); display: inline-block; line-height: 1.15; }
  .onward__link:hover .onward__name, .onward__link:focus-visible .onward__name { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 6px; text-decoration-color: var(--pomegranate); }
  .onward__media { display: block; aspect-ratio: 3 / 2; overflow: hidden; border: 1px solid var(--ink); margin-top: var(--s-2); }
  .onward__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms ease-out; }
  .onward__link:hover .onward__media :global(img) { transform: scale(1.04); }
  .onward__all { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); margin: var(--s-12) 0 0; max-width: none; }
  .onward__all a { display: inline-flex; align-items: center; min-height: var(--tap); font-weight: 700; }
</style>
